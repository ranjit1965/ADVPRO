{
  "_comment": "Master definitions shared by the frontend (src/config/masters.json) and the backend (backend/app/masters.json). Each master is stored in its own MongoDB collection named master_<key>. Keep both copies identical.",
  "masters": [
    {
      "key": "batches",
      "label": "Batch",
      "description": "Batches, their course, faculty, dates and timing. Uploaded from the BatchMaster Excel file (Master › Batch Import) or added here. Tick the boxes to delete several batches at once. Each faculty sees the batches assigned to them in the Class tab.",
      "idPrefix": "BAT",
      "unique": "batchNo",
      "titleField": "batchNo",
      "fields": [
        {
          "key": "batchNo",
          "label": "Batch No",
          "type": "text",
          "required": true
        },
        {
          "key": "courseId",
          "label": "Course",
          "type": "lookup",
          "source": "courses",
          "required": false
        },
        {
          "key": "facultyCode",
          "label": "Faculty",
          "type": "lookup",
          "source": "employees"
        },
        {
          "key": "facultyShort",
          "label": "Short Name",
          "type": "text",
          "hint": "Faculty short name from the BatchMaster file"
        },
        {
          "key": "otherFaculty",
          "label": "Other Faculty",
          "type": "text",
          "hideInTable": true,
          "hint": "More employee codes for this batch, comma separated"
        },
        {
          "key": "startDate",
          "label": "Start Date",
          "type": "date"
        },
        {
          "key": "endDate",
          "label": "End Date",
          "type": "date"
        },
        {
          "key": "timing",
          "label": "Timing",
          "type": "text"
        },
        {
          "key": "classType",
          "label": "Class Type",
          "type": "select",
          "options": [
            "WeekDays",
            "WeekEnd"
          ]
        },
        {
          "key": "totalHours",
          "label": "Total Hours",
          "type": "number",
          "hideInTable": true
        },
        {
          "key": "courseType",
          "label": "Course Type",
          "type": "text",
          "hideInTable": true
        },
        {
          "key": "mode",
          "label": "Mode",
          "type": "select",
          "options": [
            "Center",
            "At College"
          ],
          "default": "Center"
        },
        {
          "key": "classMode",
          "label": "Online / Offline",
          "type": "select",
          "options": [
            "Offline",
            "Online"
          ],
          "default": "Offline"
        },
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "options": [
            "Planned",
            "Running",
            "Break",
            "Completed"
          ],
          "required": true,
          "default": "Planned"
        }
      ]
    }
  ]
}
