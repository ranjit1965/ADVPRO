# ---- Database ----
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=daily_entry_report

# ---- Login tokens ----
# Any long random text (40+ characters). Changing it logs everyone out.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
# Frontend address(es), comma separated.
CORS_ORIGINS=http://localhost:5173

# ---- Email (required): sends the manager sign-up verification code ----
# Gmail: turn on 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords and paste its 16 letters (no spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=yourname@gmail.com
# true for port 587 (STARTTLS). Port 465 uses SSL automatically.
SMTP_STARTTLS=true
OTP_EXPIRE_MINUTES=10
# Local time used in emails, minutes from UTC (330 = India)
UTC_OFFSET_MINUTES=330
# "Request new course" emails go to these addresses (comma separated)
COURSE_REQUEST_EMAILS=ranjit@vectratech.in,admin@vectratech.in
# Outlook / Microsoft 365: SMTP_HOST=smtp.office365.com, port 587
# Zoho Mail:               SMTP_HOST=smtp.zoho.in, port 587

# ---- WhatsApp (Pinbot) message for "Request new course" ----
# Sent together with the email to Manager and Admin. Leave WA_API_KEY empty to send email only.
WA_API_BASE=https://partnersv1.pinbot.ai/v3
WA_API_KEY=
WA_PHONE_NUMBER_ID=
WA_TEMPLATE_ID=
WA_TEMPLATE_NAME=
WA_TEMPLATE_LANG=en
# Manager and Admin WhatsApp numbers with country code, comma separated (e.g. 919876543210,919812345678)
WA_NOTIFY_NUMBERS=
# What goes in the template {{1}}, {{2}} ... in order (employee, code, employeeCode, course, courseId, remarks, date, email).
# Must have as many names as the approved template has variables.
WA_TEMPLATE_PARAMS=employee,code,course,courseId,remarks

# ---- Missing daily entries: automatic Inactive ----
# FACULTY role only: employees with no daily entry on their last 3 working days are made Inactive (cannot sign in).
# Manager or Admin makes them Active again in Master > Employees; the next 3 working days then count afresh.
# true = the API runs the check itself once a day at AUTO_INACTIVE_TIME (local time, UTC_OFFSET_MINUTES).
# false = run it from cron / Windows Task Scheduler instead:  cd backend && python -m app.auto_inactive
AUTO_INACTIVE_ENABLED=true
AUTO_INACTIVE_TIME=06:00
AUTO_INACTIVE_DAYS=3
AUTO_INACTIVE_ROLES=FACULTY
# Weekly off days: 0=Mon 1=Tue 2=Wed 3=Thu 4=Fri 5=Sat 6=Sun  ("5,6" = Saturday and Sunday off)
AUTO_INACTIVE_WEEKLY_OFF=6
# Holidays, YYYY-MM-DD comma separated, e.g. 2026-12-25,2027-01-01,2027-01-26..
AUTO_INACTIVE_HOLIDAYS=
# First day that counts. Empty = the day this version first started (older days never count).
AUTO_INACTIVE_START_DATE=
