{
  "_comment": "Master definitions shared by the frontend (src/config/masters.json) and the backend (backend/app/masters.json). Each master is stored in its own MongoDB collection named master_<key>. Keep both copies identical.",
  "masters": [
    {
      "key": "batches",
      "label": "Batch",
      "description": "Batches, their course, faculty (internal or external), dates and timing. Uploaded from the BatchMaster Excel file (Master › Batch Import) or added here. Each faculty sees the batches assigned to them in the Class tab.",
      "idPrefix": "BAT",
      "unique": "batchNo",
      "titleField": "batchNo",
      "fields": [
        {
          "key": "batchNo",
          "label": "Batch No",
          "type": "text",
          "required": true
        },
        {
          "key": "courseId",
          "label": "Course",
          "type": "lookup",
          "source": "courses",
          "required": true
        },
        {
          "key": "facultyType",
          "label": "Faculty Type",
          "type": "toggle",
          "options": [
            "Internal",
            "External"
          ],
          "required": true,
          "default": "Internal"
        },
        {
          "key": "facultyCode",
          "label": "Faculty",
          "type": "lookup",
          "source": "faculties",
          "required": true,
          "showIf": {
            "facultyType": "Internal"
          },
          "tableMerge": {
            "key": "externalFacultyId",
            "source": "externalFaculties"
          }
        },
        {
          "key": "externalFacultyId",
          "label": "External Faculty",
          "type": "lookup",
          "source": "externalFaculties",
          "required": true,
          "showIf": {
            "facultyType": "External"
          },
          "hideInTable": true,
          "addNew": "externalFaculty",
          "addNewLabel": "Add external faculty"
        },
        {
          "key": "facultyShort",
          "label": "Short Name",
          "type": "text",
          "hint": "Faculty short name from the BatchMaster file",
          "required": false,
          "hidden": true
        },
        {
          "key": "otherFaculty",
          "label": "Other Faculty",
          "type": "text",
          "hidden": true
        },
        {
          "key": "startDate",
          "label": "Start Date",
          "type": "date",
          "required": true
        },
        {
          "key": "endDate",
          "label": "End Date",
          "type": "date",
          "required": true
        },
        {
          "key": "timing",
          "label": "Timing",
          "type": "timerange",
          "hint": "Class time From and To",
          "required": true
        },
        {
          "key": "mode",
          "label": "Mode",
          "type": "lookup",
          "default": "Center",
          "required": true,
          "source": "batchModes"
        },
        {
          "key": "classMode",
          "label": "Online / Offline",
          "type": "select",
          "options": [
            "Offline",
            "Online"
          ],
          "default": "Offline",
          "required": true
        },
        {
          "key": "status",
          "label": "Status",
          "type": "lookup",
          "required": true,
          "default": "Planned",
          "source": "batchStatuses"
        }
      ]
    },
    {
      "key": "externalFaculty",
      "label": "External Faculty",
      "description": "Faculty from outside the company, with phone and email. Chosen as the faculty of a batch (Faculty Type External).",
      "idPrefix": "EXF",
      "unique": "email",
      "titleField": "name",
      "fields": [
        {
          "key": "name",
          "label": "Name",
          "type": "text",
          "required": true
        },
        {
          "key": "phone",
          "label": "Phone",
          "type": "phone",
          "required": true,
          "hint": "10-digit mobile"
        },
        {
          "key": "email",
          "label": "Email",
          "type": "email",
          "required": true
        },
        {
          "key": "dob",
          "label": "Date of Birth",
          "type": "date",
          "required": false,
          "hint": "Optional. For birthday wishes on WhatsApp."
        },
        {
          "key": "anniversary",
          "label": "Anniversary Date",
          "type": "date",
          "required": false,
          "hint": "Optional. Wedding anniversary, for wishes on WhatsApp."
        },
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "options": [
            "Active",
            "Inactive"
          ],
          "default": "Active",
          "required": true
        }
      ]
    }
  ]
}
