{
  "_comment": "Master definitions shared by the frontend (src/config/masters.json) and the backend (backend/app/masters.json). Each master is stored in its own MongoDB collection named master_<key>. Keep both copies identical.",
  "masters": [
    {
      "key": "batches",
      "label": "Batch",
      "description": "Batches, their course, faculty, dates and timing. Uploaded from the BatchMaster Excel file (Master › Batch Import) or added here. Tick the boxes to delete several batches at once. Each faculty sees the batches assigned to them in the Class tab.",
      "idPrefix": "BAT",
      "unique": "batchNo",
      "titleField": "batchNo",
      "fields": [
        {
          "key": "batchNo",
          "label": "Batch No",
          "type": "text",
          "required": true
        },
        {
          "key": "courseId",
          "label": "Course",
          "type": "lookup",
          "source": "courses",
          "required": true
        },
        {
          "key": "facultyCode",
          "label": "Faculty",
          "type": "lookup",
          "source": "employees",
          "required": true
        },
        {
          "key": "facultyShort",
          "label": "Short Name",
          "type": "text",
          "hint": "Faculty short name from the BatchMaster file",
          "required": true
        },
        {
          "key": "otherFacultyType",
          "label": "Additional Faculty",
          "type": "toggle",
          "options": [
            "None",
            "Internal",
            "External"
          ],
          "required": true,
          "default": "None",
          "hint": "Another faculty for this batch: one of our employees (Internal) or from outside (External)"
        },
        {
          "key": "otherFaculty",
          "label": "Internal Faculty",
          "type": "lookup",
          "source": "employees",
          "required": true,
          "showIf": {
            "otherFacultyType": "Internal"
          }
        },
        {
          "key": "externalFaculty",
          "label": "External Faculty",
          "type": "text",
          "required": true,
          "showIf": {
            "otherFacultyType": "External"
          },
          "hint": "Name of the faculty from outside"
        },
        {
          "key": "startDate",
          "label": "Start Date",
          "type": "date",
          "required": true
        },
        {
          "key": "endDate",
          "label": "End Date",
          "type": "date",
          "required": true
        },
        {
          "key": "timing",
          "label": "Timing",
          "type": "timerange",
          "hint": "Class time From and To",
          "required": true
        },
        {
          "key": "classType",
          "label": "Class Type",
          "type": "select",
          "options": [
            "WeekDays",
            "WeekEnd"
          ],
          "required": true
        },
        {
          "key": "totalHours",
          "label": "Total Hours",
          "type": "number",
          "hideInTable": true,
          "required": true
        },
        {
          "key": "courseType",
          "label": "Course Type",
          "type": "text",
          "hideInTable": true,
          "required": true
        },
        {
          "key": "mode",
          "label": "Mode",
          "type": "select",
          "options": [
            "Center",
            "At College"
          ],
          "default": "Center",
          "required": true
        },
        {
          "key": "classMode",
          "label": "Online / Offline",
          "type": "select",
          "options": [
            "Offline",
            "Online"
          ],
          "default": "Offline",
          "required": true
        },
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "options": [
            "Planned",
            "Running",
            "Break",
            "Completed"
          ],
          "required": true,
          "default": "Planned"
        }
      ]
    }
  ]
}
